{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepsight/protocols/schemas/tracking_target.json",
  "title": "Tracking Target",
  "description": "Tracking result with bounding box and confidence.",
  "type": "object",
  "required": ["x", "y", "confidence", "track_id", "visible"],
  "properties": {
    "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Center X normalized to frame width"
    },
    "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Center Y normalized to frame height"
    },
    "w": {
      "type": "number",
      "description": "Bounding box width normalized"
    },
    "h": {
      "type": "number",
      "description": "Bounding box height normalized"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Detection confidence"
    },
    "track_id": {
      "type": "integer",
      "description": "ByteTrack tracking ID (-1 if lost)"
    },
    "visible": {
      "type": "boolean",
      "description": "Target is currently visible"
    }
  }
}
