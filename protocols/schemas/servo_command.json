{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepsight/protocols/schemas/servo_command.json",
  "title": "Servo Command",
  "description": "Set servo angle command.",
  "type": "object",
  "required": ["servo_id", "angle"],
  "properties": {
    "servo_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15,
      "description": "Servo channel on PCA9685"
    },
    "angle": {
      "type": "number",
      "minimum": 0,
      "maximum": 180,
      "description": "Target angle in degrees"
    },
    "speed": {
      "type": "number",
      "default": 0.0,
      "description": "Movement speed (0 = maximum)"
    }
  }
}
