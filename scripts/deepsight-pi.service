[Unit]
Description=DeepSight Pi Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tony
WorkingDirectory=/home/tony/deepsight
ExecStart=/usr/bin/python3 -m deepsight_pi.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deepsight-pi

[Install]
WantedBy=multi-user.target
